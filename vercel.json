{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "data/**"
    }
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index?__route=/" },
    { "source": "/api/login-request", "destination": "/api/index?__route=/api/login-request" },
    { "source": "/api/login-verify", "destination": "/api/index?__route=/api/login-verify" },
    { "source": "/api/:path*", "destination": "/api/index?__route=/api/:path*" },
    { "source": "/shortcut-help", "destination": "/api/index?__route=/shortcut-help" },
    { "source": "/download/shortcut", "destination": "/api/index?__route=/download/shortcut" }
  ]
}
